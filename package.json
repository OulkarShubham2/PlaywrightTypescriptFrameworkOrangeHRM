{
  "name": "playwrightframework",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "npx playwright test",
    "test_dev": "cross-env ENV_NAME=dev npx playwright test",
    "test_demo": "cross-env ENV_NAME=demo npx playwright test",
    "test_qa": "cross-env ENV_NAME=qa npx playwright test",
    "test_prod": "cross-env ENV_NAME=prod npx playwright test",
    "test_dev_cr": "cross-env ENV_NAME=dev npx playwright test --project=chromium",
    "test_dev_fr": "cross-env ENV_NAME=dev npx playwright test --project=firefox",
    "test_dev_wk": "cross-env ENV_NAME=dev npx playwright test --project=webkit",
    "test_demo_cr": "cross-env ENV_NAME=demo npx playwright test --project=chromium",
    "test_demo_fr": "cross-env ENV_NAME=demo npx playwright test --project=firefox",
    "test_demo_wk": "cross-env ENV_NAME=demo npx playwright test --project=webkit",
    "test_demo_cr_hd": "cross-env ENV_NAME=demo npx playwright test --project=chromium --headed",
    "test_demo_fr_hd": "cross-env ENV_NAME=demo npx playwright test --project=firefox --headed",
    "test_demo_wk_hd": "cross-env ENV_NAME=demo npx playwright test --project=webkit --headed",
    "test_demo_cr_ui": "cross-env ENV_NAME=demo npx playwright test --project=chromium --ui",
    "test_demo_fr_ui": "cross-env ENV_NAME=demo npx playwright test --project=firefox --ui",
    "test_demo_debug": "cross-env ENV_NAME=demo npx playwright test --debug",
    "test_demo_trace": "cross-env ENV_NAME=demo npx playwright test --trace on",
    "test_demo_smoke": "cross-env ENV_NAME=demo npx playwright test --grep \"@smoke\"",
    "test_demo_sanity": "cross-env ENV_NAME=demo npx playwright test --grep \"@sanity\"",
    "test_demo_regression": "cross-env ENV_NAME=demo npx playwright test --grep \"@regression\"",
    "test_demo_api": "cross-env ENV_NAME=demo npx playwright test --grep \"@api\"",
    "test_demo_ui": "cross-env ENV_NAME=demo npx playwright test --grep \"@ui\"",
    "test_demo_smoke_hd": "cross-env ENV_NAME=demo npx playwright test --grep \"@smoke\" --headed",
    "test_demo_sanity_hd": "cross-env ENV_NAME=demo npx playwright test --grep \"@sanity\" --headed",
    "test_demo_regression_hd": "cross-env ENV_NAME=demo npx playwright test --grep \"@regression\" --headed",
    "test_demo_serial": "cross-env ENV_NAME=demo npx playwright test --workers=1",
    "test_demo_parallel": "cross-env ENV_NAME=demo npx playwright test --workers=4",
    "test_demo_retry": "cross-env ENV_NAME=demo npx playwright test --retries=2",
    "test_demo_last_failed": "cross-env ENV_NAME=demo npx playwright test --last-failed",
    "test_demo_list": "cross-env ENV_NAME=demo npx playwright test --list",
    "test_login": "cross-env ENV_NAME=demo npx playwright test tests/login.spec.ts",
    "test_pim": "cross-env ENV_NAME=demo npx playwright test tests/pim-module.spec.ts",
    "test_api": "cross-env ENV_NAME=demo npx playwright test tests/api",
    "report_html": "npx playwright show-report",
    "report_trace": "npx playwright show-trace",
    "allure_generate": "allure generate allure-results --clean -o allure-report",
    "allure_open": "allure open allure-report",
    "allure_serve": "allure serve allure-results",
    "codegen": "npx playwright codegen",
    "install_browsers": "npx playwright install",
    "update_snapshots": "npx playwright test --update-snapshots",
    "api_test": "cross-env ENV_NAME=demo npx playwright test --project=apiTest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/crypto-js": "^4.2.2",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^26.1.1",
    "allure-playwright": "^3.10.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "cross-env": "^10.1.0",
    "crypto-js": "^4.2.0",
    "csv-parse": "^7.0.2",
    "dotenv": "^17.4.2"
  }
}
